#!/bin/bash

USAGE="$0 [-h] jobid commit [feature_commit]"

while getopts ":h" opt
do
  case ${opt} in
    h)
      echo "help: $USAGE"
      exit 0
      ;;
    [?])
      echo "Usage: $USAGE"
      exit 1
      ;;
    *)
      echo "Usage: $USAGE"
      exit 1
      ;;
  esac
done
shift $((OPTIND - 1))

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
    echo "Wrong number of args $#, must specify jobid and one or two commits"
    echo "$USAGE"
    exit 2
fi

jobid1=$1
if ! baseline_commit=$(git rev-parse --short "$2^{commit}" 2> /dev/null); then
  echo "Invalid commit $2"
  exit 3
fi
if [ "$#" -eq 3 ]; then
  if ! feature_commit=$(git rev-parse --short "$3^{commit}" 2> /dev/null); then
    echo "Invalid commit $3"
    exit 3
  fi
fi

read -r -d '' sql <<- _EOM_
.headers on
.mode column
CREATE TABLE IF NOT EXISTS coverage (
  job TEXT,
  branch TEXT,
  commit_hash TEXT,
  dirty TEXT,
  filename TEXT,
  regions INTEGER,
  missed_regions INTEGER,
  region_cover REAL,
  functions INTEGER,
  missed_functions INTEGER,
  function_cover REAL,
  lines INTEGER,
  missed_lines INTEGER,
  line_cover REAL,
  branches INTEGER,
  missed_branches INTEGER,
  branch_cover REAL
);
with summarized_coverage as (
  select
    job,
    filename,
    commit_hash,
    avg(region_cover) as region_cover,
    avg(function_cover) as function_cover,
    avg(line_cover) as line_cover,
    avg(branch_cover) as branch_cover
  from coverage
  group by job, commit_hash, filename
)
_EOM_

if [ "$#" -eq 2 ]; then
read -r -d '' report_sql <<- _EOM_
select
  filename,
  printf("%  .2f", region_cover) as region_cover,
  printf("%  .2f", function_cover) as function_cover,
  printf("%  .2f", line_cover) as line_cover,
  printf("%  .2f", branch_cover) as branch_cover
from summarized_coverage
WHERE job = "${jobid1}" AND commit_hash = "${baseline_commit}" AND filename = "TOTAL"
_EOM_
else
read -r -d '' report_sql <<- _EOM_
select
  baseline.filename as filename,
  printf("%  .2f", baseline.region_cover) as region_baseline,
  printf("%  .2f", feature.region_cover) as region_feature,
  printf("%  .2f", feature.region_cover - baseline.region_cover) as region_change,
  printf("%  .2f", baseline.function_cover) as function_baseline,
  printf("%  .2f", feature.function_cover) as function_feature,
  printf("%  .2f", feature.function_cover - baseline.function_cover) as function_change,
  printf("%  .2f", baseline.line_cover) as line_baseline,
  printf("%  .2f", feature.line_cover) as line_feature,
  printf("%  .2f", feature.line_cover - baseline.line_cover) as line_change,
  printf("%  .2f", baseline.branch_cover) as branch_baseline,
  printf("%  .2f", feature.branch_cover) as branch_feature,
  printf("%  .2f", feature.branch_cover - baseline.branch_cover) as branch_change
from summarized_coverage baseline
JOIN summarized_coverage feature on baseline.filename = feature.filename
WHERE baseline.job = "${jobid1}" AND baseline.commit_hash = "${baseline_commit}" AND
  feature.job = "${jobid1}" AND feature.commit_hash = "${feature_commit}" AND
  (ABS(branch_change) > 0.1 OR ABS(line_change) > 0.1 OR ABS(function_change) > 0.1 OR ABS(region_change) > 0.1 OR baseline.filename = "TOTAL")
_EOM_
fi

printf "%s\n%s\n" "$sql" "$report_sql" | sqlite3 test-results.sqlite
